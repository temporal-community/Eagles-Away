# Production requires live planning, Temporal TLS and WORKER_BUILD_ID.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
ADDITIONAL_FRONTEND_ORIGINS=
PREVIEW_ACCESS_REQUIRED=true
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cpfc:cpfc@localhost:5432/cpfc
# PostgreSQL connections per process. Budget pool + overflow for every API process, old and
# new worker replica, and concurrent job during deployment (22 connections on the 1 GiB plan).
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=2
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cpfc-trip-v3
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
# With a build ID, the worker joins Worker Deployment cpfc-trip and the API pins new sessions to it.
WORKER_BUILD_ID=
# Concurrent activities per worker; each planning session runs about four searches at once.
WORKER_MAX_ACTIVITIES=64
PLANNER_MODE=recorded
SEARCHAPI_API_KEY=
SEARCHAPI_ENABLED=true
SEARCH_CACHE_ENABLED=true
# Positive search freshness in minutes. Set 0 or disable the cache to bypass stored results.
SEARCH_CACHE_TTL_MINUTES=1440
# On provider errors, serve older positive results for this long beyond their fresh TTL.
SEARCH_CACHE_STALE_IF_ERROR_MINUTES=1440
# Refresh positive results early on average beta × the live search duration. Set 0 to disable.
SEARCH_CACHE_EARLY_BETA=240
# New sessions per IPv4 address or IPv6 /64 per minute, and across all clients per ten minutes.
SESSION_CREATE_PER_MINUTE=3
SESSION_CREATE_PER_10_MINUTES=10
# Snapshot polls per client IP per minute, counted in each API process.
SNAPSHOT_POLLS_PER_MINUTE=240
